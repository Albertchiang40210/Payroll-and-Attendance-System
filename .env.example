PORT=3001
NODE_ENV=development

# docker-compose 使用
SYSTEM_TZ=Asia/Taipei
MYSQL_ROOT_PASS=change_me
MYSQL_DB_NAME=punch_db
DB_PORT_EXTERNAL=3311
APP_PORT_EXTERNAL=3001

# 本機執行 (npm start / npx prisma / npm test) 使用；port 需與 DB_PORT_EXTERNAL 一致
DATABASE_URL="mysql://root:change_me@localhost:3311/punch_db"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"
